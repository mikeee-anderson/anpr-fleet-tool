# Copy to .env and fill in. Never commit the real .env.
# Every value is optional: with no folder or SHEET_ID the server still runs
# and plates are printed to the console instead of written to Google Sheets.

# ---- Where plates go ----
# A Drive folder of monthly spreadsheets (the newest is used), and the
# template spreadsheet that "Start new month" copies. IDs are the long
# strings in the folder's and the spreadsheet's URLs.
SHEETS_FOLDER_ID=
SHEETS_TEMPLATE_ID=
# Monthly files are named "<prefix> - November 2026"
SHEET_TITLE_PREFIX=Yard audit
# Or, instead of a folder: one fixed spreadsheet
SHEET_ID=

# The day tabs' layout. Defaults match the physical fleet report:
# a TEMPLATE tab, REGO in column A from row 6, the block A:D.
# SHEET_TEMPLATE_TAB=TEMPLATE
# SHEET_FIRST_ROW=6
# SHEET_BLOCK=A:D

# ---- Google credentials: set ONE ----
# A sign-in to your Google account from backend/scripts/google_sign_in.py
# (needed to create monthly files in your Drive). The simplest local setup:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/backend/google-token.json
GOOGLE_APPLICATION_CREDENTIALS=
# ...or the same file's contents on one line
GOOGLE_OAUTH_TOKEN_JSON=
# ...or a service account key on one line (only with SHEET_ID, shared with it)
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- App access ----
# When set, logging, undo and the sheet settings need header X-API-Key.
# Put the same value in mobile/.env as EXPO_PUBLIC_API_KEY.
API_KEY=
