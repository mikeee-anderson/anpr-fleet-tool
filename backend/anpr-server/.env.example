# Copy to .env and fill in. Never commit the real .env.
# Every value is optional: with SHEET_ID unset the server still runs and
# plate logs are printed to the console instead of written to Google Sheets.

# ID of the Google Sheet to log to (the long string in the sheet's URL).
SHEET_ID=

# Google credentials - set ONE of these. Leave both empty on Cloud Run,
# where the service's own identity is used and no key is needed.
# 1) the whole service account JSON, on one line:
GOOGLE_SERVICE_ACCOUNT_JSON=
# 2) or a path to the key file inside the container:
GOOGLE_APPLICATION_CREDENTIALS=
